# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Required for `pnpm discover` (the LLM-driven discovery loop). Not needed for `pnpm replay`,
# which never calls the model.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the discovery agent loop.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Run the browser headed (visible) so runs are watchable and so a human can take over the
# SAME session during a HITL escalation. Set to true for headless CI/test runs.
PLAYWRIGHT_HEADLESS=false

# Default target application for the demo capability.
TARGET_BASE_URL=https://www.saucedemo.com

# minimal | debug
LOG_LEVEL=minimal
